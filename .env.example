# ==========================================
# Database Configuration (Supabase / Local)
# ==========================================
# Local Docker: postgresql://appuser:apppassword@db:5432/appdb
# Supabase Pooler (Recommended for Vercel): postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://appuser:apppassword@db:5432/appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
POSTGRES_DB=appdb

# ==========================================
# JWT Security
# ==========================================
JWT_SECRET_KEY=change-me-to-a-random-secret-key-32-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ==========================================
# Supabase Storage (Optional for Local, Required for Vercel)
# ==========================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_BUCKET=uploads
